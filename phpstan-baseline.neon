parameters:
	ignoreErrors:
		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 1
			path: Action/ShippingAction.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: Action/ShippingAction.php

		-
			message: '#^Method Omnibus\\ZtoExpress\\Action\\ShippingAction\:\:party\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Action/ShippingAction.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: Action/TrackingAction.php

		-
			message: '#^Cannot access offset 0 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Action/TrackingAction.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: Action/TrackingAction.php

		-
			message: '#^Parameter \#1 \$type of static method Omnibus\\ZtoExpress\\Action\\TrackingAction\:\:status\(\) expects string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Action/TrackingAction.php

		-
			message: '#^Parameter \#2 \$desc of static method Omnibus\\ZtoExpress\\Action\\TrackingAction\:\:status\(\) expects string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Action/TrackingAction.php

		-
			message: '#^Parameter \#4 \$location of class Omnibus\\Model\\TrackingEvent constructor expects string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Action/TrackingAction.php

		-
			message: '#^Parameter \#5 \$code of class Omnibus\\Model\\TrackingEvent constructor expects string\|null, mixed given\.$#'
