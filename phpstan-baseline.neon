			count: 1
			path: Action/TrackingAction.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 3
			path: Api.php

		-
			message: '#^Method Omnibus\\ZtoExpress\\Api\:\:call\(\) has parameter \$data with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Api.php

		-
			message: '#^Method Omnibus\\ZtoExpress\\Api\:\:call\(\) should return array\<string, mixed\> but returns array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Method Omnibus\\ZtoExpress\\Api\:\:secrets\(\) should return list\<string\> but returns non\-empty\-array\<int\<0, max\>\|string, string\>\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Cannot access offset ''district'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Tests/ZtoExpressGatewayTest.php

		-
			message: '#^Cannot access offset ''partner'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Tests/ZtoExpressGatewayTest.php

		-
			message: '#^Cannot access offset ''province'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Tests/ZtoExpressGatewayTest.php

		-
			message: '#^Cannot access offset ''receiver'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Tests/ZtoExpressGatewayTest.php

		-
			message: '#^Cannot access offset ''sender'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Tests/ZtoExpressGatewayTest.php

		-
			message: '#^Cannot access property \$location on Omnibus\\Model\\TrackingEvent\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/ZtoExpressGatewayTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: Tests/ZtoExpressGatewayTest.php

		-
			message: '#^Cannot use array destructuring on mixed\.$#'
			identifier: offsetAccess.nonArray
			count: 1
			path: Tests/ZtoExpressGatewayTest.php

		-
			message: '#^Parameter \#1 \$body of class Symfony\\Component\\HttpClient\\Response\\MockResponse constructor expects iterable\<string\|Throwable\>\|string, string\|false given\.$#'
			identifier: argument.type
			count: 5
			path: Tests/ZtoExpressGatewayTest.php

		-
